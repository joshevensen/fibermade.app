# Copy to .env and adjust for your environment. All are optional — each
# falls back to the default set in nuxt.config.ts when unset.

# Pre-launch copy. Set to false to switch the whole site to live wording
# (announcement bar disappears, CTAs/badges revert). Defaults to true.
NUXT_PUBLIC_COMING_SOON=true

# Renders the dashed "REPLACE — …" briefs over stand-in imagery. Set to
# false once real photography is in place. Defaults to true.
NUXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Base URL of the app (login/signup) for this environment. When set, the
# header's Log in / Sign up links appear, pointing at {appUrl}/login and
# {appUrl}/register. Leave unset to hide both links. Defaults to unset.
NUXT_PUBLIC_APP_URL=https://app.staging.fibermade.app
